{
  "name": "clipforge-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/server-core",
    "packages/video-engine",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @clipforge/web",
    "dev:api": "npm run dev -w @clipforge/api",
    "dev:worker": "npm run dev -w @clipforge/worker",
    "build": "npm run build -w @clipforge/api -w @clipforge/worker -w @clipforge/web",
    "start:api": "npm run start -w @clipforge/api",
    "start:worker": "npm run start -w @clipforge/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/e2e-prepare.mjs && playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env scripts/migrate.mjs --reset",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
