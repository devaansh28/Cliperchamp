# ClipForge AI — copy to .env and fill in. Never commit .env.
# The API and worker read this file (node --env-file). The web app only reads VITE_* variables,
# which end up in the browser bundle: never put secrets in a VITE_* variable.

# --- General ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173
API_PORT=8787
# Public URL of the API (used to build local signed file URLs).
API_BASE_URL=http://localhost:8787
TRUST_PROXY=false

# --- Database (Supabase Postgres, or any PostgreSQL 15+ for local development) ---
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/clipforge
DB_POOL_MAX=10

# --- Auth --------------------------------------------------------------------
# supabase (production) or local (development and tests only; refused when NODE_ENV=production)
AUTH_PROVIDER=local
# Required for AUTH_PROVIDER=local. At least 32 random characters: openssl rand -base64 48
AUTH_JWT_SECRET=
# Required for AUTH_PROVIDER=supabase or STORAGE_PROVIDER=supabase.
SUPABASE_URL=
# Optional legacy HS256 JWT secret. When empty, tokens are verified with the project's JWKS.
SUPABASE_JWT_SECRET=
# Server-only. Used for Storage. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage -----------------------------------------------------------------
# supabase (private bucket) or local (development only)
STORAGE_PROVIDER=local
STORAGE_BUCKET=clipforge-media
LOCAL_STORAGE_DIR=.data/storage
# Required for STORAGE_PROVIDER=local. At least 32 random characters.
STORAGE_SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_FILE_SIZE_MB=200

# --- Script generation (optional) ---------------------------------------------
# none | anthropic | openai-compatible. With none, users write scripts by hand.
LLM_PROVIDER=none
LLM_API_KEY=
# anthropic default: claude-opus-5-5
LLM_MODEL=
# Required for openai-compatible, e.g. https://api.example.com/v1
LLM_BASE_URL=

# --- Voiceover (optional) -------------------------------------------------------
# none | espeak (free, local, needs espeak-ng installed) | openai-compatible
TTS_PROVIDER=none
TTS_API_KEY=
TTS_MODEL=
TTS_BASE_URL=
ESPEAK_PATH=espeak-ng

# --- Stock media (optional) -------------------------------------------------------
# none | pexels (free API key from pexels.com/api)
MEDIA_PROVIDER=none
MEDIA_API_KEY=

# --- Word-level caption alignment (optional) ----------------------------------------
# none | openai-compatible (Whisper-style /audio/transcriptions with word timestamps)
ALIGN_PROVIDER=none
ALIGN_API_KEY=
ALIGN_MODEL=
ALIGN_BASE_URL=

# --- Rendering (worker) ------------------------------------------------------------
RENDER_CONCURRENCY=1
RENDER_MAX_DURATION_SECONDS=180
RENDER_MAX_FILE_SIZE_MB=500
RENDER_TIMEOUT_SECONDS=1800
RENDER_RETENTION_DAYS=14
# Path to a Chrome/Chromium headless shell. Empty = Remotion downloads its own.
RENDER_BROWSER_EXECUTABLE=
# Optional Chromium GL backend: swangle | angle | egl | swiftshader | vulkan | angle-egl
RENDER_GL=
TEMP_RENDER_DIR=.tmp/renders
# Remotion company license key, if your company needs one (see docs/integrations.md).
REMOTION_LICENSE_KEY=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional liveness port for the worker (GET /health).
WORKER_HEALTH_PORT=

# --- Social publishing (optional) ------------------------------------------------------
# Lets users connect YouTube, TikTok and Instagram and post finished exports. Each platform
# works only after you create a developer app there; see docs/integrations.md.
# 32 random bytes, base64. Encrypts stored platform tokens. Generate: openssl rand -base64 32
# Changing it disconnects every account (tokens can no longer be decrypted).
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Redirect URI to register on every platform: <API_BASE_URL>/api/social/oauth/<platform>/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Parallel uploads per worker.
PUBLISH_CONCURRENCY=2

# --- Demo quotas (per user per month; nothing is ever charged) ----------------------
QUOTA_SCRIPT_GENERATIONS=50
QUOTA_VOICE_SECONDS=1800
QUOTA_STORAGE_MB=2048
QUOTA_RENDER_SECONDS=3600
QUOTA_EXPORTS=50

# --- API protection ------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=300
# Bearer token for /health/metrics. Without it, metrics are disabled in production.
METRICS_TOKEN=

# --- Web (public, bundled into the browser) ---------------------------------------------
# Empty in development (Vite proxies /api and /files). In production: the API origin.
VITE_API_BASE_URL=
# local | supabase — must match AUTH_PROVIDER
VITE_AUTH_PROVIDER=local
VITE_SUPABASE_URL=
# Supabase publishable (anon) key. Safe in browsers; Row Level Security protects data.
VITE_SUPABASE_PUBLISHABLE_KEY=
